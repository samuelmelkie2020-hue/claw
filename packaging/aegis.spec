# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec: builds the Aegis desktop app for the current platform.

    pyinstaller --noconfirm packaging/aegis.spec

Produces dist/Aegis (Linux/macOS) or dist/Aegis.exe (Windows). Everything the
app reads at runtime from the bundle — the web UI — is collected explicitly;
the user's settings live outside the bundle (see aegis.config.user_data_dir).
"""

import os
import sys
from pathlib import Path

ROOT = Path(SPECPATH).resolve().parent  # noqa: F821 - SPECPATH is packaging/
sys.path.insert(0, str(ROOT))


def _aegis_version() -> str:
    """The one version number, read from the package itself."""
    from aegis import __version__

    return __version__

# Per-platform icon, so the executable, the window and the Dock/Taskbar all
# agree. Generated by packaging/make_icon.py; a missing icon must not break a
# build, so this degrades to Whatever the OS shows for a plain executable.
ASSETS = ROOT / "packaging" / "assets"
if sys.platform.startswith("win"):
    _icon_file = ASSETS / "aegis.ico"
elif sys.platform == "darwin":
    _icon_file = ASSETS / "aegis.icns"
else:
    _icon_file = ASSETS / "aegis.png"
icon = str(_icon_file) if _icon_file.exists() else None

# ---------------------------------------------------------------------------
# GTK typelibs for the Linux window
#
# pywebview's Linux backend needs Gtk + WebKit2 through GI, and GI typelibs are
# *data*: PyInstaller cannot find them by following imports. On a bare runner
# (xvfb, no pip install at run time) they must be inside the bundle, or the window
# can never be created — "You must have either QT or GTK with Python extensions".
# This used to run before `hiddenimports` existed and raised NameError, which is
# why the collection silently did nothing.
# ---------------------------------------------------------------------------
def _gi_datas() -> list:
    if not sys.platform.startswith("linux"):
        return []
    wanted = ("Gtk-3.0", "Gdk-3.0", "WebKit2-4.1", "WebKit2-4.0", "Gio-2.0", "GLib-2.0", "GObject-2.0")
    hooks = []
    try:
        from PyInstaller.utils import hooks as _hooks

        for name in ("collect_typelib_data", "collect_gi_typelibs"):
            collector = getattr(_hooks, name, None)
            if collector is not None:
                hooks.append(collector)
    except Exception:
        pass
    for collector in hooks:
        try:
            found = []
            for typelib in wanted:
                try:
                    found.extend(collector(typelib))
                except Exception:
                    continue
            if found:
                print(f"[aegis] typelibs collected via {collector.__name__}: {len(found)}")
                return found
        except Exception:
            continue
    # Last resort: copy the typelib files straight out of the standard location.
    found = []
    for pattern in ("/usr/lib/*/girepository-1.0", "/usr/lib/girepository-1.0"):
        for directory in Path("/").glob(pattern.lstrip("/")):
            for path in directory.glob("*.typelib"):
                if path.stem in wanted:
                    found.append((str(path), "gi_typelibs"))
    if found:
        print(f"[aegis] typelibs copied from disk: {len(found)}")
    return found


_typelibs = _gi_datas()

datas = list(_typelibs) + [
    (str(ROOT / "aegis" / "static"), "aegis/static"),  # includes aegis.png (window icon)
    # The bootstrap locates the real entry point at runtime. Carrying it as data
    # is what makes --self-check and --diagnose work in the *frozen* build,
    # which is exactly when a user needs them.
    (str(ROOT / "run.py"), "."),
]
# psutil ships a small binary shim; pywebview/uvicorn need their submodules named
# explicitly because they are imported lazily at runtime.
hiddenimports = [
    "uvicorn",
    "uvicorn.logging",
    "uvicorn.loops.auto",
    "uvicorn.loops.asyncio",
    "uvicorn.protocols.http.auto",
    "uvicorn.protocols.http.h11_impl",
    "uvicorn.protocols.websockets.auto",
    "uvicorn.lifespan.off",
    "webview",
    "webview.platforms",
    "aegis.desktop",
    # The default brain lives here and is imported lazily from config.py,
    # server.py and run.py, so PyInstaller cannot see it from the imports alone.
    "aegis.local_llm",
]
if sys.platform.startswith("win"):
    hiddenimports += ["webview.platforms.edgechromium", "webview.platforms.winforms"]
elif sys.platform == "darwin":
    hiddenimports += ["webview.platforms.cocoa"]
else:
    # The frozen binary is run on a bare runner (xvfb, no pip install), so GTK and
    # its GI typelib have to be *inside* the bundle. Without them the window can
    # never be created: "You must have either QT or GTK with Python extensions".
    hiddenimports += [
        "webview.platforms.gtk",
        "webview.platforms.qt",
        "gi",
        "gi.repository",
        "gi.repository.Gtk",
        "gi.repository.Gdk",
        "gi.repository.GLib",
        "gi.repository.Gio",
    ]

excludes = [
    "tkinter",          # pywebview may probe Tk; we never use it
    "matplotlib", "numpy", "pandas", "scipy", "IPython", "pytest", "ruff",
]

# The bootstrap, not run.py: a windowed build has no console, so anything that
# fails before a window exists must still leave a log and a dialog behind.
analysis = Analysis(  # noqa: F821
    [str(ROOT / "packaging" / "entry.py")],
    pathex=[str(ROOT)],
    binaries=[],
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    runtime_hooks=[],
    excludes=excludes,
    noarchive=False,
)

pyz = PYZ(analysis.pure)  # noqa: F821

executable = EXE(  # noqa: F821
    pyz,
    analysis.scripts,
    analysis.binaries,
    analysis.datas,
    name="Aegis",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,          # no terminal window: this is a GUI app
    icon=icon,
)

if sys.platform == "darwin":
    app = BUNDLE(  # noqa: F821
        executable,
        name="Aegis.app",
        icon=icon,
        bundle_identifier="dev.aegis.desktop",
        info_plist={
            "CFBundleName": "Aegis",
            "CFBundleDisplayName": "Aegis",
            "CFBundleShortVersionString": _aegis_version(),
            "NSHighResolutionCapable": True,
            # The assistant reads the screen and types: both need consent.
            "NSAppleEventsUsageDescription":
                "Aegis needs this to open apps and control your Mac for you.",
            "NSScreenCaptureUsageDescription":
                "Aegis takes a screenshot only when you ask what is on your screen.",
            "LSUIElement": False,
        },
    )
